# Configuracoes do Bot Noite Eterna
# Este arquivo eh gerado e lido automaticamente pela interface desktop,
# mas voce tambem pode editar diretamente se preferir.

# Token do Bot criado no Discord Developer Portal
DISCORD_BOT_TOKEN=

# ID do Servidor (Guild ID) - Opcional se o bot estiver em apenas 1 servidor
DISCORD_GUILD_ID=

# ID do Canal de Voz Padrao - Opcional (pode ser selecionado pela ficha)
DISCORD_VOICE_CHANNEL_ID=

# Chave de API de seguranca local (Opcional)
DISCORD_API_KEY=chaveforteteste

# Porta do servidor local de roteamento (onde a ficha web se conecta)
PORT=3001

# Origem do frontend permitida (use * para permitir qualquer site/ficha)
FRONTEND_ORIGIN=*

# Configuracoes do App Desktop
MINIMIZE_TO_TRAY=true
START_MINIMIZED=false
