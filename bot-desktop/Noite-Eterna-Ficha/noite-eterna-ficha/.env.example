# Chave usada pelo assistente Gemini no frontend (opcional)
VITE_GEMINI_API_KEY=

# URL HTTPS do Cloudflare Tunnel apontando para o bot local.
# Em desenvolvimento local, deixe vazio para usar 127.0.0.1:3001.
VITE_BOT_API_URL=

# Deve ser igual ao DISCORD_API_KEY do bot-desktop/.env quando VITE_BOT_API_URL estiver preenchida.
VITE_BOT_API_KEY=
